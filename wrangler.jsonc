{
  // Cloudflare Worker serving ./public, plus /api/inquiry (see worker/index.ts),
  // which emails water test requests to Dan through Resend.
  //
  // Pairs with these Cloudflare build settings (Settings -> Build):
  //   Build command:  (empty)
  //   Deploy command: npx wrangler deploy
  "name": "american-soft-water",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Unknown URLs get public/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // API routes must reach the Worker before the 404 handling above can
    // answer a GET for them.
    "run_worker_first": ["/api/*"]
  },
  // Live on americansoftwater.com. Listed here so every deploy keeps them
  // attached; a Cloudflare Redirect Rule sends the bare domain to www.
  "routes": [
    { "pattern": "www.americansoftwater.com", "custom_domain": true },
    { "pattern": "americansoftwater.com", "custom_domain": true }
  ],
  // The workers.dev address is off so it can't compete in search results.
  "workers_dev": false,
  "preview_urls": false
  // Secret, set in the dashboard or with `npx wrangler secret put RESEND_API_KEY`.
  // Optional vars INQUIRY_TO / INQUIRY_FROM: see worker/inquiry.ts.
}
