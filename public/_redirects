# Redirect table for the static files (Cloudflare Workers static assets).
#
# Old Wix addresses that have no page of their own on the new site get a 301
# to the closest match, so bookmarks and search results don't hit a 404.
#
# No target below can match its own rule, so none of these can loop. Keep it
# that way when adding rules.

# The service pages (/water-softener, /iron-filters, /reverse-osmosis,
# /water-filtration, /free-water-test) are real pages again, at the same
# addresses the Wix site used, so they are not redirected.
/contact-us          /free-water-test   301
/contact-us/         /free-water-test   301
/gallery             /#installs         301
/gallery/            /#installs         301

# Wix store and blog pages. There is no store or blog on the new site.
/shop                /                  301
/shop/               /                  301
/products-1          /                  301
/products-1/         /                  301
/blog                /                  301
/blog/               /                  301
/product-page/*      /                  301
/blog/*              /                  301
/post/*              /                  301
/category/*          /                  301
