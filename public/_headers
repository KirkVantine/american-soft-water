# Response headers for the static files (Cloudflare Workers static assets).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Images, styles and scripts rarely change; the ?v= query on the CSS/JS links
# in index.html busts the cache when they do.
/assets/*
  Cache-Control: public, max-age=604800
